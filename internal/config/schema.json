{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "affer://schema.json",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "model": { "type": "string" },
    "fallback": { "type": "array", "items": { "type": "string" } },
    "theme": { "type": "string" },
    "maxSteps": { "type": "integer", "minimum": 1 },
    "budgetUSD": { "type": "number", "minimum": 0 },
    "autoApprove": { "type": "boolean" },
    "pure": { "type": "boolean" },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string" }, "fast": { "type": "string" },
        "title": { "type": "string" }, "compact": { "type": "string" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "options": { "type": "object" },
          "models": { "type": "object" }
        }
      }
    },
    "permission": {
      "type": "object",
      "properties": {
        "bash": { "type": "string" }, "edit": { "type": "string" },
        "write": { "type": "string" }, "webfetch": { "type": "string" },
        "read": { "type": "string" }, "mode": { "type": "string" },
        "deny": { "type": "array", "items": { "type": "string" } }
      }
    },
    "formatters": { "type": "object" },
    "lsp": { "type": "object" },
    "mcp": { "type": "object" }
  }
}
